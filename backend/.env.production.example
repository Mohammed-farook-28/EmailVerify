# =============================================================================
# EmailKit Backend — Production Environment Variables
# Copy to .env and fill in all values before deploying.
# =============================================================================

# ---- Core ----
NODE_ENV=production
PORT=3000
FRONTEND_URL=https://app.emailkit.com
BACKEND_URL=https://api.emailkit.com

# ---- Database ----
DATABASE_URL=postgresql://user:password@host:5432/emailkit

# ---- Redis ----
REDIS_URL=redis://:password@host:6379
REDIS_HOST=host
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password

# ---- Auth ----
BETTER_AUTH_BASE_URL=https://api.emailkit.com
SESSION_SECRET=generate-a-256-bit-random-hex-string
CSRF_SECRET=generate-a-256-bit-random-hex-string

# ---- Google OAuth ----
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret
GOOGLE_CALLBACK_URL=https://api.emailkit.com/api/auth/callback/google

# ---- Email (Resend) ----
RESEND_API_KEY=re_your-resend-api-key
FROM_EMAIL=noreply@emailkit.com

# ---- DigitalOcean Spaces (Avatars) ----
DO_SPACES_KEY=your-spaces-access-key
DO_SPACES_SECRET=your-spaces-secret-key
DO_SPACES_BUCKET=emailkit-avatars
DO_SPACES_REGION=nyc3
DO_SPACES_CDN_URL=https://emailkit-avatars.nyc3.cdn.digitaloceanspaces.com

# ---- DigitalOcean Spaces (Bulk Results) ----
SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
SPACES_REGION=nyc3
SPACES_ACCESS_KEY=your-spaces-access-key
SPACES_SECRET_KEY=your-spaces-secret-key
SPACES_BUCKET=emailkit-bulk-results

# ---- Stripe ----
STRIPE_SECRET_KEY=sk_live_your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_live_your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret

# ---- Credits ----
SIGNUP_BONUS_CREDITS=100

# ---- Upstream Email Verification API ----
UPSTREAM_API_URL=https://api.emailverify.ai/v1
UPSTREAM_API_KEY=sk_your-upstream-api-key

# ---- Workers ----
WORKER_CONCURRENCY=50
BATCH_SIZE=100

# ---- Bulk Verification ----
MAX_FILE_SIZE=10485760
MAX_EMAILS=100000
RETENTION_DAYS=14

# ---- OpenTelemetry (optional) ----
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318/v1/traces
